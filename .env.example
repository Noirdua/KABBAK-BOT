# Discord (optional if Matrix is configured)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Matrix — password login OR access token. Homeserver is required.
# MATRIX_URL is accepted as an alias for MATRIX_HOMESERVER.
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER_ID=@kabbak:example.org
# MATRIX_USERNAME=kabbak
MATRIX_PASSWORD=
# Prefer an access token after the first password login (token is also saved
# to storage/matrix/session.json). MATRIX_USERNAME is an alias for the localpart.
# MATRIX_ACCESS_TOKEN=
# MATRIX_PREFIX=!kabbak

# Future: Telegram adapter is not wired yet
# TELEGRAM_BOT_TOKEN=

# KABBAK API base (include /api/v1)
KABBAK_API_URL=http://localhost:3100/api/v1

# Shared bot fallback when a user has not saved their own key
KABBAK_API_KEY=

# Encrypts user API keys in storage/users.json.
# Defaults to DISCORD_TOKEN / TELEGRAM_BOT_TOKEN / MATRIX_ACCESS_TOKEN if unset.
# Set this before running more than one platform so rotating a chat token does
# not invalidate saved keys. Changing it invalidates saved keys.
# KABBAK_KEY_ENCRYPTION_SECRET=
